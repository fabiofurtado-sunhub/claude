# ──────────────────────────────────────────────
# MX3 Agents — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# ──────────────────────────────────────────────

# ── Anthropic (Claude) ──────────────────────────
# Chave da API Anthropic (obrigatória)
# Gere em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── OpenAI (Embeddings) ─────────────────────────
# Necessário para geração de embeddings (RAG com pgvector)
# Se não configurado, RAG ficará desabilitado
# Gere em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Supabase ────────────────────────────────────
# URL do projeto Supabase
# Encontre em: Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave de serviço (service_role) — NUNCA exponha no frontend
# Encontre em: Settings > API > service_role key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Zapi (WhatsApp Gateway) ─────────────────────
# ID da instância Zapi
# Encontre no painel: https://app.z-api.io
ZAPI_INSTANCE_ID=

# Token de autenticação da instância
ZAPI_TOKEN=

# URL base da API Zapi (não altere a não ser que use proxy)
ZAPI_BASE_URL=https://api.z-api.io

# ── Webhook ──────────────────────────────────────
# Secret para validar requisições recebidas do webhook
# Gere um valor aleatório: openssl rand -hex 32
WEBHOOK_SECRET=

# ── Servidor ─────────────────────────────────────
# Porta do servidor HTTP (padrão: 3000)
PORT=3000

# ── Configurações Opcionais ───────────────────────
# Ambiente (development | production)
NODE_ENV=development
